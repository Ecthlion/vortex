+if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
+  message(FATAL_ERROR "CUDF_WITH_VORTEX requires Linux and a CUDA toolkit")
+endif()
+
+block()
+  # CPM's DOWNLOAD_ONLY path does not honor FetchContent source overrides itself.
+  if(FETCHCONTENT_SOURCE_DIR_VORTEX)
+    set(vortex_SOURCE_DIR "${FETCHCONTENT_SOURCE_DIR_VORTEX}")
+  else()
+    CPMAddPackage(
+      NAME vortex
+      GIT_REPOSITORY https://github.com/vortex-data/vortex.git
+      GIT_TAG 90723345eeed838405341da9d44e02c94f10e6be
+      DOWNLOAD_ONLY TRUE
+    )
+  endif()
+
+  set(vortex_module "${vortex_SOURCE_DIR}/benchmarks/cudf-ndsh/vortex.cmake")
+  if(NOT EXISTS "${vortex_module}" OR IS_DIRECTORY "${vortex_module}")
+    message(FATAL_ERROR
+      "CUDF_WITH_VORTEX requires Vortex sources containing benchmarks/cudf-ndsh/vortex.cmake "
+      "(got '${vortex_SOURCE_DIR}'). A local checkout can be selected with "
+      "-DFETCHCONTENT_SOURCE_DIR_VORTEX=/path/to/vortex.")
+  endif()
+  include("${vortex_module}")
+endblock()
